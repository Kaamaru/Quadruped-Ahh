/*
 * Controller Firmware - ESP32 Arduino core 3.x - DEVICE MODE 1 (CONTROLLER)
 * Generated by PCA9685 Control Studio.
 * Plug this board into your PC. Web commands are forwarded to the robot over ESP-NOW:
 * servo commands are batched into single packets, and whole sequences are uploaded in a few acknowledged chunks.
 * It also forwards the robot's status, servo telemetry and orientation to the web page, and streams its own orientation (MPU6050 + compass).
 * Libraries: "Adafruit MPU6050", "Adafruit Unified Sensor", "Adafruit AHRS"
 * Serial (115200):  s <pin> <angle>   PU ... (program chunk)   PS (stop)   c <id> <arg>   ?   f 1|0   g   m 1|0   o x y z
 */

#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <esp_err.h>
#include <esp_mac.h>
#include <string.h>
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_AHRS.h>

#define DEVICE_MODE 1   // 0 = robot, 1 = controller
#define DEVICE_NAME "CONTROLLER"
#define CFG_ID      "9d9fdde1"   // id of the config baked into this code
#define VERBOSE     0   // 1 = print debug info on Serial (set in the web Settings)
#define LOG(...)    do { if (VERBOSE) Serial.printf(__VA_ARGS__); } while (0)
#define ESPNOW_CHANNEL 1
#define SDA_PIN 21
#define SCL_PIN 22

// Must match the ROBOT's MAC (shown when you connect to the robot).
const uint8_t ROBOT_MAC[6] = {0xB4, 0xBF, 0xE9, 0x0B, 0x16, 0x70};   // B4:BF:E9:0B:16:70

struct __attribute__((packed)) ImuMsg {   // robot -> controller telemetry
  uint8_t type;
  float w, x, y, z;
};

String line;
bool streaming = false;                 // this board's orientation stream (switched from the web page)
ImuMsg robotImu;                        // newest quaternion received from the robot
volatile bool robotImuNew = false;
uint8_t telBuf[64];                     // newest servo telemetry from the robot
volatile int telLen = 0;
uint8_t tiltBuf[6];                     // newest tilt / balance state from the robot
volatile bool tiltNew = false;
uint8_t stq[8][3];                      // robot status events waiting to be printed
volatile uint8_t stHead = 0, stTail = 0;
portMUX_TYPE rxMux = portMUX_INITIALIZER_UNLOCKED;
volatile int sendState = 0;             // 0 = waiting, 1 = delivered, 2 = failed (set by the send callback)
int16_t pendAngle[16];                  // servo commands collected for the next batch packet (-1 = none)
uint32_t lastFlushMs = 0, lastFailMs = 0;

// ---- radio protocol (shared by robot and controller) ----
#define CMD_PROG    0xB1   // controller -> robot: chunk of a sequence program (upload, then run)
#define CMD_STOP    0xB4   // controller -> robot: stop the running program
#define CMD_BATCH   0xB6   // controller -> robot: move several servos together (one packet)
#define CMD_CTRL    0xB7   // controller -> robot: small settings (telemetry, loop, clear overload, speed, balance)
#define CMD_BAL     0xB8   // controller -> robot: balance gains
#define MSG_IMU     0xA1   // robot -> controller: orientation
#define MSG_STATUS  0xA2   // robot -> controller: events (program received, overload ...)
#define MSG_TELEM   0xA3   // robot -> controller: servo target / commanded / physical positions
#define MSG_TILT    0xA4   // robot -> controller: body tilt and balance state
#define CHUNK_BYTES 200    // program bytes per packet (ESP-NOW allows 250)

// ---- Sensor fusion: MPU6050 (0x68) + compass (0x2C) -> Mahony filter -> quaternion ----
// Libraries: "Adafruit MPU6050", "Adafruit Unified Sensor", "Adafruit AHRS"
#define MAG_ADDR 0x2C
#define I2C_CLOCK 400000       // faster I2C (400 kHz). Use 100000 if your wires are long or flaky.
#define FUSION_EVERY 4         // filter runs at 100 Hz, one quaternion is sent every N samples (4 = 25 per second)
// Compass hard-iron offsets: written by the web page (Calibrate tab -> Settings). "o x y z" changes them until reboot.
float magOffX = -50.0;
float magOffY = -100.0;
float magOffZ = -60.0;
bool magStream = false;        // raw compass stream for the web calibration page
unsigned long lastMagStreamMs = 0;

Adafruit_MPU6050 mpu;
Adafruit_Mahony filter;
bool magOk = false;
int fusionState = 0;           // 0 = not started, 1 = OK, 2 = MPU6050 not found
float gyroBiasX = 0, gyroBiasY = 0, gyroBiasZ = 0;
unsigned long lastFusionUs = 0;
int fusionTick = 0;
float qW = 1, qX = 0, qY = 0, qZ = 0;
// body tilt for balancing (sensor X forward, Z up): pitch + = nose down, roll + = right side down
float tiltPitch = 0, tiltRoll = 0, tiltPitchRate = 0, tiltRollRate = 0;
bool tiltInit = false;

bool readMagRaw(int16_t &rx, int16_t &ry, int16_t &rz) {
  Wire.beginTransmission(MAG_ADDR);
  Wire.write(0x01);
  Wire.endTransmission();
  Wire.requestFrom(MAG_ADDR, 6);
  if (Wire.available() < 6) return false;
  uint8_t xl = Wire.read(); uint8_t xh = Wire.read();
  uint8_t yl = Wire.read(); uint8_t yh = Wire.read();
  uint8_t zl = Wire.read(); uint8_t zh = Wire.read();
  rx = (int16_t)(xh << 8 | xl);
  ry = (int16_t)(yh << 8 | yl);
  rz = (int16_t)(zh << 8 | zl);
  return true;
}

bool readMag(float &mx, float &my, float &mz) {
  int16_t rx, ry, rz;
  if (!readMagRaw(rx, ry, rz)) return false;
  mx = (float)rx - magOffX;      // same axis flips as your sensorfusion1.ino
  my = -(float)ry - magOffY;
  mz = -(float)rz - magOffZ;
  return true;
}

void calibrateGyro() {
  Serial.println("FUSION calibrating gyro, keep still...");
  float sx = 0, sy = 0, sz = 0;
  for (int i = 0; i < 200; i++) {
    sensors_event_t a, g, t;
    mpu.getEvent(&a, &g, &t);
    sx += g.gyro.x; sy += g.gyro.y; sz += g.gyro.z;   // float sums (a long would truncate the values)
    delay(10);
  }
  gyroBiasX = sx / 200.0f;
  gyroBiasY = sy / 200.0f;
  gyroBiasZ = sz / 200.0f;
  Serial.println("FUSION gyro calibrated");
}

void initFusion() {
  if (!mpu.begin()) {
    Serial.println("ERR MPU6050 not found, sensor fusion disabled");
    fusionState = 2;
    return;
  }
  Wire.beginTransmission(0x68);   // wake up, use the gyro clock
  Wire.write(0x6B);
  Wire.write(0x01);
  Wire.endTransmission();
  mpu.setAccelerometerRange(MPU6050_RANGE_4_G);
  mpu.setGyroRange(MPU6050_RANGE_250_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_44_HZ);

  Wire.beginTransmission(MAG_ADDR);   // compass init
  Wire.write(0x0A);
  Wire.write(0xCF);
  magOk = (Wire.endTransmission() == 0);
  if (!magOk) Serial.println("WARN compass not found, using gyro + accelerometer only");

  calibrateGyro();
  filter.begin(100);
  lastFusionUs = micros();
  fusionState = 1;
  Serial.println("FUSION ready");
}

// Runs the filter at a steady 100 Hz without blocking. Returns true when a new sample was computed.
bool updateFusion() {
  if (fusionState != 1) return false;
  unsigned long now = micros();
  unsigned long dt = now - lastFusionUs;
  if (dt < 10000) return false;
  lastFusionUs = (dt > 50000) ? now : lastFusionUs + 10000;

  sensors_event_t a, g, t;
  mpu.getEvent(&a, &g, &t);
  float gx = (g.gyro.x - gyroBiasX) * 57.2958f;   // rad/s -> deg/s
  float gy = (g.gyro.y - gyroBiasY) * 57.2958f;
  float gz = (g.gyro.z - gyroBiasZ) * 57.2958f;

  float accPitch = atan2f(-a.acceleration.x, sqrtf(a.acceleration.y * a.acceleration.y + a.acceleration.z * a.acceleration.z)) * 57.2958f;
  float accRoll = atan2f(a.acceleration.y, a.acceleration.z) * 57.2958f;
  if (!tiltInit) { tiltPitch = accPitch; tiltRoll = accRoll; tiltInit = true; }
  tiltPitch = 0.98f * (tiltPitch + gy * 0.01f) + 0.02f * accPitch;   // gyro for speed, accelerometer for the long-term truth
  tiltRoll = 0.98f * (tiltRoll + gx * 0.01f) + 0.02f * accRoll;
  tiltPitchRate = gy;
  tiltRollRate = gx;

  float mx, my, mz;
  if (magOk && readMag(mx, my, mz)) {
    filter.update(gx, gy, gz, a.acceleration.x, a.acceleration.y, a.acceleration.z, mx, my, mz);
  } else {
    filter.updateIMU(gx, gy, gz, a.acceleration.x, a.acceleration.y, a.acceleration.z);
  }
  filter.getQuaternion(&qW, &qX, &qY, &qZ);
  return true;
}

// Calibration stream "M <r|c> x y z": compass values after the axis flips, before the offsets are subtracted.
void streamMag(char src) {
  if (!magStream || !magOk || millis() - lastMagStreamMs < 20) return;
  lastMagStreamMs = millis();
  int16_t rx, ry, rz;
  if (readMagRaw(rx, ry, rz)) Serial.printf("M %c %d %d %d\n", src, (int)rx, -(int)ry, -(int)rz);
}

// "Q <r|c> w x y z"  (r = robot, c = controller). The web page draws the 3D view from these lines.
void printQuat(char src) {
  Serial.printf("Q %c %.4f %.4f %.4f %.4f\n", src, qW, qX, qY, qZ);
}

void macToStr(char *out) {   // out needs 18 bytes
  uint8_t m[6];
  esp_read_mac(m, ESP_MAC_WIFI_STA);
  snprintf(out, 18, "%02X:%02X:%02X:%02X:%02X:%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
}

void printHello() {
  char mac[18];
  macToStr(mac);
  Serial.printf("HELLO mode=%d name=%s cfg=%s mac=%s fusion=%d fstream=%d compass=%d prog=1 fb=%d bal=%d\n",
                DEVICE_MODE, DEVICE_NAME, CFG_ID, mac, fusionState, streaming ? 1 : 0, (magOk ? 1 : 0), 0, 0);
}

// "T r <mask> <stalledMask> <flags> target:commanded:physical,..."  (physical = -1 when the servo has no feedback)
void printTelemetry(const uint8_t *b, int len) {
  uint16_t mask = b[1] | (b[2] << 8), stm = b[3] | (b[4] << 8);
  char out[260];
  int n = snprintf(out, sizeof(out), "T r %u %u %u ", (unsigned)mask, (unsigned)stm, (unsigned)b[5]);
  int idx = 6;
  bool first = true;
  for (int p = 0; p < 16; p++) {
    if (!(mask & (1 << p))) continue;
    if (idx + 3 > len || n > (int)sizeof(out) - 16) break;
    int a = b[idx + 2];
    n += snprintf(out + n, sizeof(out) - n, "%s%d:%d:%d", first ? "" : ",", b[idx], b[idx + 1], a == 255 ? -1 : a);
    idx += 3;
    first = false;
  }
  Serial.println(out);
}

void onSent(const wifi_tx_info_t *info, esp_now_send_status_t status) {
  sendState = (status == ESP_NOW_SEND_SUCCESS) ? 1 : 2;
}

// Radio callback: only stores what the robot sent. loop() prints it for the web page.
void onRecv(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len < 4) return;
  if (info != nullptr && info->src_addr != nullptr && memcmp(info->src_addr, ROBOT_MAC, 6) != 0) return;
  if (data[0] == MSG_IMU && len == sizeof(ImuMsg)) {
    memcpy(&robotImu, data, sizeof(ImuMsg));
    robotImuNew = true;
  } else if (data[0] == MSG_STATUS && len == 4) {
    portENTER_CRITICAL(&rxMux);
    uint8_t nx = (stHead + 1) % 8;
    if (nx != stTail) { stq[stHead][0] = data[1]; stq[stHead][1] = data[2]; stq[stHead][2] = data[3]; stHead = nx; }
    portEXIT_CRITICAL(&rxMux);
  } else if (data[0] == MSG_TILT && len == 6) {
    portENTER_CRITICAL(&rxMux);
    memcpy(tiltBuf, data, 6);
    tiltNew = true;
    portEXIT_CRITICAL(&rxMux);
  } else if (data[0] == MSG_TELEM && len <= (int)sizeof(telBuf)) {
    portENTER_CRITICAL(&rxMux);
    memcpy(telBuf, data, len);
    telLen = len;
    portEXIT_CRITICAL(&rxMux);
  }
}

// Sends one packet to the robot and waits for the radio acknowledgement, retrying a few times.
bool sendReliable(const uint8_t *buf, size_t len, int tries) {
  for (int t = 0; t < tries; t++) {
    sendState = 0;
    esp_err_t err = esp_now_send(ROBOT_MAC, buf, len);
    if (err == ESP_OK) {
      uint32_t t0 = millis();
      while (sendState == 0 && millis() - t0 < 25) delay(1);
      if (sendState == 1) return true;
    } else {
      delay(5);
    }
  }
  if (lastFailMs == 0 || millis() - lastFailMs > 1000) {   // do not flood the log when the robot is off
    lastFailMs = millis() + 1;
    Serial.println("ESP-NOW delivery: FAIL");
  }
  return false;
}

// Servo commands that arrive close together leave as ONE packet, so the radio is never flooded
// and the robot moves all of those servos together.
void queueServo(int pin, int angle) {
  if (pin < 0 || pin > 15) { Serial.println("ERR invalid pin"); return; }
  pendAngle[pin] = constrain(angle, 0, 180);
}

void flushServos() {
  if (millis() - lastFlushMs < 15) return;
  uint8_t buf[3 + 16];
  uint16_t mask = 0;
  int n = 3;
  for (int p = 0; p < 16; p++) if (pendAngle[p] >= 0) { mask |= 1 << p; buf[n++] = (uint8_t)pendAngle[p]; }
  if (!mask) return;
  lastFlushMs = millis();
  buf[0] = CMD_BATCH; buf[1] = mask & 255; buf[2] = mask >> 8;
  bool ok = sendReliable(buf, n, 3);
  for (int p = 0; p < 16; p++) pendAngle[p] = -1;   // stale commands are dropped, never sent late
  if (ok) LOG("Sent batch mask 0x%04X\n", mask);
}

int hexNibble(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

int decodeHex(const char *h, uint8_t *out, int maxLen) {
  int n = 0;
  while (h[0] && h[1] && n < maxLen) {
    int a = hexNibble(h[0]), b = hexNibble(h[1]);
    if (a < 0 || b < 0) break;
    out[n++] = (uint8_t)((a << 4) | b);
    h += 2;
  }
  return n;
}

// "PU <id> <flags> <total> <crc> <offset> <hex>": one chunk of a sequence program, forwarded to the robot
void forwardProgram(const String &s) {
  int id = 0, flags = 0, total = 0, crc = 0, off = 0, used = 0;
  if (sscanf(s.c_str() + 3, "%d %d %d %d %d %n", &id, &flags, &total, &crc, &off, &used) < 5 || used <= 0) {
    Serial.println("ERR PU format");
    return;
  }
  uint8_t pkt[9 + CHUNK_BYTES];
  int n = decodeHex(s.c_str() + 3 + used, pkt + 9, CHUNK_BYTES);
  if (n <= 0) { Serial.printf("ERR PU %d\n", off); return; }
  pkt[0] = CMD_PROG; pkt[1] = (uint8_t)id; pkt[2] = (uint8_t)flags;
  pkt[3] = total & 255; pkt[4] = total >> 8;
  pkt[5] = crc & 255;   pkt[6] = crc >> 8;
  pkt[7] = off & 255;   pkt[8] = off >> 8;
  if (sendReliable(pkt, 9 + n, 4)) Serial.printf("OK PU %d\n", off);
  else Serial.printf("ERR PU %d\n", off);
}

void handleLine(String s) {
  s.trim();
  if (s == "?" || s == "hello") {
    printHello();
    return;
  }
  if (s == "f 1" || s == "f 0") {
    streaming = (s == "f 1");
    if (streaming) { lastFusionUs = micros(); fusionTick = 0; }
    Serial.printf("FUSION stream %d\n", streaming ? 1 : 0);
    return;
  }
  if (s == "g") {
    calibrateGyro();
    lastFusionUs = micros();
    return;
  }
  if (s == "m 1" || s == "m 0") {
    magStream = (s == "m 1");
    Serial.printf("FUSION mag stream %d\n", magStream ? 1 : 0);
    return;
  }
  if (s.startsWith("o ")) {   // "o x y z": compass offsets until reboot
    float ox, oy, oz;
    if (sscanf(s.c_str() + 2, "%f %f %f", &ox, &oy, &oz) == 3) {
      magOffX = ox; magOffY = oy; magOffZ = oz;
      Serial.printf("FUSION offsets %.1f %.1f %.1f\n", ox, oy, oz);
    }
    return;
  }
  if (s.startsWith("PU ")) { forwardProgram(s); return; }
  if (s == "PS") {
    uint8_t b[1] = { CMD_STOP };
    Serial.println(sendReliable(b, 1, 4) ? "OK PS" : "ERR PS");
    return;
  }
  if (s.startsWith("c ")) {   // "c <id> <arg>": telemetry on/off, loop, clear overload, speed
    int cid = 0, arg = 0;
    if (sscanf(s.c_str() + 2, "%d %d", &cid, &arg) >= 1) {
      uint8_t b[3] = { CMD_CTRL, (uint8_t)cid, (uint8_t)arg };
      sendReliable(b, 3, 3);
    }
    return;
  }
  if (s.startsWith("bt ")) {   // "bt <kp> <ki> <kd> <max>": balance gains, packed into one packet for the robot
    float a, b, c2, d2;
    if (sscanf(s.c_str() + 3, "%f %f %f %f", &a, &b, &c2, &d2) == 4) {
      uint16_t v[4] = { (uint16_t)lroundf(constrain(a, 0.0f, 10.0f) * 100.0f), (uint16_t)lroundf(constrain(b, 0.0f, 5.0f) * 1000.0f), (uint16_t)lroundf(constrain(c2, 0.0f, 2.0f) * 1000.0f), (uint16_t)lroundf(constrain(d2, 2.0f, 45.0f) * 10.0f) };
      uint8_t pk[9] = { CMD_BAL };
      for (int i = 0; i < 4; i++) { pk[1 + 2 * i] = v[i] & 255; pk[2 + 2 * i] = v[i] >> 8; }
      Serial.println(sendReliable(pk, 9, 3) ? "OK bt" : "ERR bt");
    }
    return;
  }
  if (s.startsWith("fbcal") || s.startsWith("fbset")) {
    Serial.println("ERR connect to the robot directly for feedback calibration");
    return;
  }
  if (s.startsWith("s ")) {
    int sp = s.indexOf(' ', 2);
    if (sp > 0) queueServo(s.substring(2, sp).toInt(), s.substring(sp + 1).toInt());
    else Serial.println("ERR format: s <pin> <angle>");
  }
}

void setup() {
  Serial.setRxBufferSize(2048);   // program chunks are long lines
  Serial.begin(115200);
  delay(500);
  Serial.println("\nCONTROLLER BOOTING");
  for (int i = 0; i < 16; i++) pendAngle[i] = -1;

  Wire.setPins(SDA_PIN, SCL_PIN);
  initFusion();
  Wire.setClock(I2C_CLOCK);

  if (!WiFi.mode(WIFI_STA)) {
    Serial.println("ERR WiFi STA mode failed");
    return;
  }
  delay(100);
  esp_err_t err = esp_wifi_set_channel(ESPNOW_CHANNEL, WIFI_SECOND_CHAN_NONE);
  LOG("Set channel %d: %d (%s)\n", ESPNOW_CHANNEL, err, esp_err_to_name(err));

  err = esp_now_init();
  if (err != ESP_OK) {
    Serial.printf("ERR ESP-NOW init: %d (%s)\n", err, esp_err_to_name(err));
    return;
  }
  esp_now_register_send_cb(onSent);
  esp_now_register_recv_cb(onRecv);

  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, ROBOT_MAC, 6);
  peer.channel = ESPNOW_CHANNEL;
  peer.ifidx = WIFI_IF_STA;
  peer.encrypt = false;
  err = esp_now_add_peer(&peer);
  if (err == ESP_ERR_ESPNOW_EXIST) LOG("ESP-NOW peer already exists\n");
  else if (err != ESP_OK) Serial.printf("ERR add peer: %d (%s)\n", err, esp_err_to_name(err));
  else LOG("ESP-NOW PEER OK\n");

  printHello();
  Serial.println("CONTROLLER READY");
}

void readSerial() {
  while (Serial.available()) {
    char ch = Serial.read();
    if (ch == '\n') {
      handleLine(line);
      line = "";
    } else if (ch != '\r') {
      line += ch;
      if (line.length() > 700) line = "";
    }
  }
}

void loop() {
  readSerial();
  flushServos();
  if (robotImuNew) {   // forward what the robot sent to the web page
    robotImuNew = false;
    Serial.printf("Q r %.4f %.4f %.4f %.4f\n", robotImu.w, robotImu.x, robotImu.y, robotImu.z);
  }
  while (stTail != stHead) {
    uint8_t ev[3];
    portENTER_CRITICAL(&rxMux);
    memcpy(ev, stq[stTail], 3);
    stTail = (stTail + 1) % 8;
    portEXIT_CRITICAL(&rxMux);
    Serial.printf("RSTAT %d %d %d\n", ev[0], ev[1], ev[2]);
  }
  if (tiltNew) {
    uint8_t tb6[6];
    portENTER_CRITICAL(&rxMux);
    memcpy(tb6, tiltBuf, 6);
    tiltNew = false;
    portEXIT_CRITICAL(&rxMux);
    int16_t p10, r10;
    memcpy(&p10, tb6 + 2, 2);
    memcpy(&r10, tb6 + 4, 2);
    Serial.printf("B r %.1f %.1f %d\n", p10 / 10.0f, r10 / 10.0f, tb6[1]);
  }
  if (telLen > 0) {
    uint8_t tb[64];
    int tl;
    portENTER_CRITICAL(&rxMux);
    tl = telLen;
    memcpy(tb, telBuf, tl);
    telLen = 0;
    portEXIT_CRITICAL(&rxMux);
    printTelemetry(tb, tl);
  }
  streamMag('c');
  if (streaming && updateFusion() && ++fusionTick >= FUSION_EVERY) {
    fusionTick = 0;
    printQuat('c');
  }
}
