/*
 * Controller Firmware (ESP32) - DEVICE MODE 1 (CONTROLLER)
 * Generated by PCA9685 Control Studio.
 * Plug this board into your PC (USB). Commands from the web page ("s <pin> <angle>")
 * are forwarded over ESP-NOW to the robot ESP32. The robot applies the servo limits.
 */
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

#define DEVICE_MODE 1   // 0 = robot, 1 = controller
#define DEVICE_NAME "CONTROLLER"
#define CFG_ID      "6fb0b3e1"   // id of the config baked into this code

void printHello() {
  uint64_t c = ESP.getEfuseMac();
  Serial.printf("HELLO mode=%d name=%s cfg=%s mac=%02X:%02X:%02X:%02X:%02X:%02X\n",
                DEVICE_MODE, DEVICE_NAME, CFG_ID,
                (uint8_t)(c >> 40), (uint8_t)(c >> 32), (uint8_t)(c >> 24),
                (uint8_t)(c >> 16), (uint8_t)(c >> 8), (uint8_t)c);
}

#define ESPNOW_CHANNEL 1
const uint8_t ROBOT_MAC[6] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00};   // MAC of the robot ESP32
typedef struct { uint8_t pin; uint8_t angle; } ServoMsg;

void sendServo(int pin, int angle) {
  if (pin < 0 || pin > 15) return;
  ServoMsg m = { (uint8_t)pin, (uint8_t)constrain(angle, 0, 180) };
  esp_err_t r = esp_now_send(ROBOT_MAC, (const uint8_t *)&m, sizeof(m));
  if (r != ESP_OK) Serial.printf("ERR espnow send %d\n", (int)r);
}

void handleLine(String s) {
  s.trim();
  if (s == "?" || s == "hello") { printHello(); return; }
  if (s.startsWith("s ")) {
    int sp = s.indexOf(' ', 2);
    if (sp > 0) sendServo(s.substring(2, sp).toInt(), s.substring(sp + 1).toInt());
  }
}

void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  esp_wifi_set_channel(ESPNOW_CHANNEL, WIFI_SECOND_CHAN_NONE);
  if (esp_now_init() != ESP_OK) { Serial.println("ERR espnow init failed"); }
  else {
    esp_now_peer_info_t peer;
    memset(&peer, 0, sizeof(peer));
    memcpy(peer.peer_addr, ROBOT_MAC, 6);
    peer.channel = ESPNOW_CHANNEL;
    peer.encrypt = false;
    if (esp_now_add_peer(&peer) != ESP_OK) Serial.println("ERR add peer failed");
  }
  printHello();
}

String line;

void loop() {
  while (Serial.available()) {
    char ch = Serial.read();
    if (ch == '\n') { handleLine(line); line = ""; }
    else if (ch != '\r') { line += ch; if (line.length() > 40) line = ""; }
  }
}
